{
  "entities": {
    "megha_chat_records": {
      "title": "Megha Chat Records",
      "description": "Stores user and Megha AI chat and voice conversation messages in real-time",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sender": { "type": "string", "enum": ["user", "megha"] },
        "text": { "type": "string" },
        "timestamp": { "type": "string" },
        "dateTimeIso": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "sender", "text", "timestamp"]
    },
    "graphValueSheets": {
      "title": "Graph Value Sheets",
      "description": "Stores uploaded Excel value sheets metadata and parsed test measurement rows",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fileName": { "type": "string" },
        "fileSize": { "type": "number" },
        "uploadedBy": { "type": "string" },
        "uploadedAt": { "type": "string" },
        "storagePath": { "type": "string" },
        "status": { "type": "string" },
        "rowCount": { "type": "number" },
        "columnCount": { "type": "number" },
        "columns": { "type": "array" },
        "timeColumn": { "type": "string" }
      },
      "required": ["id", "fileName", "rowCount", "columnCount"]
    },
    "master_templates": {
      "title": "Master Report Templates",
      "description": "Stores uploaded official DOCX Master Report templates synchronized across devices via Firebase",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reportType": { "type": "string" },
        "fileName": { "type": "string" },
        "fileSize": { "type": "number" },
        "uploadedAt": { "type": "string" },
        "base64Data": { "type": "string" },
        "chunks": { "type": "array" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "reportType", "fileName", "fileSize"]
    },
    "users": {
      "title": "Application Users",
      "description": "Stores user authorization profiles, roles, and status for Role-Based Access Control",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "random"] },
        "status": { "type": "string", "enum": ["active", "disabled", "deleted"] },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "userId", "role", "status"]
    }
  },
  "firestore": {
    "/master_templates/{reportType}": {
      "schema": "master_templates",
      "description": "DOCX Master Template files indexed by reportType (proto, reliability, etc)"
    },
    "/users/{uid}": {
      "schema": "users",
      "description": "User authorization profile records keyed by Firebase Auth UID"
    }
  }
}
